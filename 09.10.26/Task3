def print_pack_report(number):
    for n in range(number, 0, -1):
        if n % 3 == 0 and n % 5 == 0:
            print(n, "-расфасуем по 3 или по 5")
        elif n % 5 == 0:
            print(n, "-расфасуем по 5")
        elif n % 3 == 0:
            print(n, "-расфасуем по 3")
        else:
            print(n, "-не заказываем!")

# Пример использования.
print_pack_report(15)
