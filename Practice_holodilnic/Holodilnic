def add_by_note(items, note):
    parts = str.split(note, " ")
    if len(str.split(parts[-1], "-")) == 3:
        expiration_date = parts[-1]
        amount = Decimal(parts[-2])
        title = str.join(" ", parts[0:-2])
    else:
        expiration_date = None
        amount = Decimal(parts[-1])
        title = " ".join(parts[:-1])
    add(items, title, amount, expiration_date)

def find(items, needle):
    result = []
    for title in items:
        if needle.lower() in title.lower():
            result.append(title)
    return result


def get_amount(items, needle):
    amount = Decimal("0")
    for title in find(items, needle):
        for batch in items[title]:
            amount += batch["amount"]
    return amount


def get_expired(items, in_advance_days=0):
    threshold = dt.date.today() + dt.timedelta(days=in_advance_days)
    result = []
    for title, batches in items.items():
        expired_amount = Decimal("0")
        for batch in batches:
            expiration_date = batch["expiration_date"]
            if expiration_date is not None and expiration_date <= threshold:
                expired_amount += batch["amount"]
        if expired_amount > 0:
            result.append((title, expired_amount))
    return result
