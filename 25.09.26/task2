num = float(input("Введите число для проверки: "))

if num.is_integer():
    if num % 2 == 0:
        print('Число чётное')
    else:
        print('Число нечётное')
else:
    print("Число не является целым, чтобы определить чётность")

if num > 0:
    print('Число положительное')
elif num == 0:
    print("Число является нулём")
else:
    print("Число отрицательное")

if 10 <= num <= 50:
    print("Число принадлежит диапазону [10, 50]")
else:
    print("Число не принадлежит диапазону [10, 50]")
